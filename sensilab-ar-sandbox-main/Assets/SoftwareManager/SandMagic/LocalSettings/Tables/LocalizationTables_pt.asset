  - m_Id: 143085093994496
    m_Localized: "Calibra\xE7\xE3o de Canto"
    m_Metadata:
      m_Items: []
  - m_Id: 143086989819904
    m_Localized: "Instru\xE7\xF5es de calibra\xE7\xE3o de canto:\r\n\r\nArraste os
      cantos CYAN ao redor da forma da \xE1rea restrita na imagem de profundidade.\r\n\r\nArraste
      os cantos VERMELHOS para os cantos reais projetados na \xE1rea restrita (Veja
      a proje\xE7\xE3o)."
    m_Metadata:
      m_Items: []
  - m_Id: 143088579461120
    m_Localized: "Calibra\xE7\xE3o de Profundidade"
    m_Metadata:
      m_Items: []
  - m_Id: 143223535386624
    m_Localized: "Instru\xE7\xF5es de calibra\xE7\xE3o de profundidade:\r\n\r\nToque
      na parte MAIS BAIXA da imagem de profundidade e depois na MAIS ALTA.\r\n\r\nA
      faixa de profundidade pode ser ajustada com os controles deslizantes \xE0 direita."
    m_Metadata:
      m_Items: []
  - m_Id: 143224378441728
    m_Localized: "Calibra\xE7\xE3o de\r\nMudan\xE7a de lente"
    m_Metadata:
      m_Items: []
  - m_Id: 143225137610752
    m_Localized: "Instru\xE7\xF5es de calibra\xE7\xE3o de mudan\xE7a de lente:\r\n\r\nUse
      a op\xE7\xE3o Lens Shift para alinhar os picos e calhas na proje\xE7\xE3o.
      Observe que voc\xEA provavelmente ter\xE1 que usar a Tradu\xE7\xE3o Horizontal
      depois para alinhar a proje\xE7\xE3o corretamente.\r\n\r\nUse as outras op\xE7\xF5es
      para ajustar a calibra\xE7\xE3o."
    m_Metadata:
      m_Items: []
  - m_Id: 143225829670912
    m_Localized: "Mudan\xE7a de Lente"
    m_Metadata:
      m_Items: []
  - m_Id: 143226622394368
